# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (e.g. a free Neon or Supabase database)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional. Server-side Anthropic key. If unset, every visitor must add their
# own key in the app (我的 → Anthropic API Key). The Telegram bot needs this.
ANTHROPIC_API_KEY=""

# Optional. Override the model used for photo analysis (defaults to claude-haiku-4-5).
ANTHROPIC_IMAGE_MODEL=""

# Required to connect a Telegram bot from the app (我的/Me → Telegram bot).
# Encrypts the stored bot token and Anthropic key (AES-256-GCM). At least 32 chars:
#   openssl rand -hex 32
# Changing it makes stored bot settings unreadable: reconnect the bot afterwards.
APP_SECRET=""

# Optional. Public HTTPS URL of the app, used when registering the Telegram webhook.
# Defaults to the URL the request came in on. Set it when testing through a tunnel.
APP_URL=""

# Optional. Configure a bot through env vars instead of the app.
# A bot connected in the app takes priority.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Which user the env-var bot logs for (default 1, the original profile).
TELEGRAM_OWNER_USER_ID=""
# Telegram chat ids allowed to use the env-var bot (comma-separated). Unset = anyone.
# Find yours by messaging @userinfobot in Telegram.
TELEGRAM_ALLOWED_CHAT_IDS=""

# Optional. Time zone used by the Telegram bot for "today" (default Asia/Singapore).
APP_TIME_ZONE="Asia/Singapore"
